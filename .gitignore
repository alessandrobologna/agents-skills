# Publish allowlist.
# Ignore everything by default, then explicitly allow files/skills to publish.

/*

!.gitignore
!README.md

!/audit-rollout-outputs/
!/audit-rollout-outputs/**

!/rollout-output-audit/
!/rollout-output-audit/**

# Always ignore local/runtime artifacts, even inside allowlisted skills.
**/__pycache__/
*.py[cod]
.DS_Store
